{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "src/env.d.ts",
    "src/content.config.ts",
    "src/pages/**/*.astro",
    "src/layouts/**/*.astro",
    "src/components/react/**/*.tsx",
    "src/seo/config.ts"
  ],
  "exclude": ["dist", "node_modules", "src/app", "src/features", "src/components/**/*.tsx"]
}