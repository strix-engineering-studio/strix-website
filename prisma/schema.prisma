generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
}

model ContactInquiry {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    email     String
    company   String?
    category  String?
    budget    String?
    timeline  String?
    brief     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
