---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import ThemeToggle from "../components/layout/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = "Strix Engineering Studio | Architecture-First Product Engineering",
  description = "Strix Engineering Studio designs, builds, and improves production web, mobile, backend, and AI-enabled software for startups and growing businesses.",
  canonical = Astro.url.pathname,
  image = "/strix.svg",
  noindex = false
} = Astro.props;
const siteUrl = Astro.site ?? new URL("https://strix.website");
const canonicalUrl = new URL(canonical, siteUrl).toString();
const imageUrl = image.startsWith("http") ? image : new URL(image.replace(/^\/+/, ""), siteUrl).toString();
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="product engineering, software development, custom software, MVP development, AI engineering, backend engineering, software architecture, Pune" />
    <meta name="theme-color" content="#FAF8F3" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/strix.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Strix Engineering Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("strix-theme");
          const theme = saved === "light" || saved === "dark"
            ? saved
            : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.style.colorScheme = theme;
        } catch {
          // Keep the CSS light theme when browser storage is unavailable.
        }
      })();
    </script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-background text-foreground antialiased">
    <a href="#main" class="sr-only z-50 rounded-md bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <div class="relative flex min-h-screen flex-col">
      <SiteHeader />
      <main id="main" class="relative flex-1"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>