---
import ThemeToggle from "./ThemeToggle.astro";
---
<header class="sticky top-0 z-50 w-full border-b border-border/70 bg-background/95 backdrop-blur-md">
  <div class="strix-container flex h-16 items-center justify-between gap-3 sm:h-[4.5rem]">
    <a href="/" aria-label="Strix Engineering Studio home" class="group flex items-center gap-3">
      <span class="flex size-9 items-center justify-center border border-border bg-card p-1.5 shadow-sm"><img src="/strix.svg" width="26" height="26" alt="Strix logo" class="size-full object-contain" /></span>
      <span class="flex flex-col"><span class="font-mono text-xs font-semibold tracking-[0.24em] text-foreground transition-colors group-hover:text-primary">STRIX</span><span class="editorial-serif text-[11px] italic tracking-wider text-muted-foreground">Engineering Studio</span></span>
    </a>
    <nav aria-label="Main navigation" class="hidden items-center gap-1 lg:flex">
      <a class="px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-foreground/80 transition-colors hover:text-primary" href="/case-studies/">Work</a>
      <a class="px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-foreground/80 transition-colors hover:text-primary" href="/services/">Services</a>
      <a class="px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-foreground/80 transition-colors hover:text-primary" href="/#how-we-work">How We Work</a>
      <a class="px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-foreground/80 transition-colors hover:text-primary" href="/about/">Studio</a>
      <a class="px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-foreground/80 transition-colors hover:text-primary" href="/insights/">Insights</a>
    </nav>
    <div class="flex items-center gap-2">
      <div class="hidden lg:block"><ThemeToggle /></div>
      <a href="/contact/" class="inline-flex min-h-11 items-center gap-2 border border-primary bg-primary px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.16em] text-primary-foreground transition-colors hover:bg-primary/90">Start a project <span aria-hidden="true">↗</span></a>
      <button id="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation" class="inline-flex size-11 items-center justify-center border border-border text-foreground lg:hidden"><span aria-hidden="true">☰</span></button>
    </div>
  </div>
  <nav id="mobile-navigation" hidden aria-label="Mobile navigation" class="border-t border-border bg-background px-4 py-4 lg:hidden">
    <div class="strix-container grid gap-1 sm:grid-cols-2">
      <a class="border-b border-border px-2 py-3 text-sm" href="/case-studies/">Work</a><a class="border-b border-border px-2 py-3 text-sm" href="/services/">Services</a><a class="border-b border-border px-2 py-3 text-sm" href="/#how-we-work">How We Work</a><a class="border-b border-border px-2 py-3 text-sm" href="/about/">Studio</a><a class="border-b border-border px-2 py-3 text-sm" href="/insights/">Insights</a><a class="border-b border-border px-2 py-3 text-sm" href="/contact/">Contact</a>
    </div>
    <div class="strix-container mt-4 flex items-center justify-between gap-4"><span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Appearance</span><ThemeToggle /></div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("#mobile-menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
    menu.hidden = true;
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
  }));
</script>