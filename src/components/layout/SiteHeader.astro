---
import ThemeToggle from "./ThemeToggle.astro";
---
<header class="portfolio-nav">
  <div class="portfolio-nav-inner">
    <a href="/" aria-label="Strix Engineering Studio home" class="portfolio-nav-brand">
      <span class="portfolio-nav-mark"><img src="/strix.svg" width="26" height="26" alt="Strix logo"/></span>
      <span class="portfolio-nav-wordmark"><strong>STRIX</strong><small>Engineering Studio</small></span>
    </a>
    <nav aria-label="Primary navigation" class="portfolio-nav-links">
      <a href="/">Home</a>
      <a href="/#work">Work</a>
      <a href="/#process">Process</a>
      <a href="/#capabilities">Capabilities</a>
      <a href="/#stack">Technology</a>
      <a href="/insights/">Journal</a>
    </nav>
    <div class="portfolio-nav-actions">
      <a href="/contact/" class="portfolio-nav-contact">Start a project <span aria-hidden="true">↗</span></a>
      <div class="portfolio-theme-control"><ThemeToggle /></div>
      <button id="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation" class="portfolio-nav-mobile-toggle"><span aria-hidden="true">☰</span></button>
    </div>
  </div>
  <nav id="mobile-navigation" hidden aria-label="Mobile navigation" class="portfolio-nav-mobile">
    <a href="/">Home</a><a href="/#work">Work</a><a href="/#process">Process</a><a href="/#capabilities">Capabilities</a><a href="/#stack">Technology</a><a href="/insights/">Journal</a><a href="/contact/">Contact</a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("#mobile-menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
    menu.hidden = true;
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
  }));
</script>