---
const projects = [
  {
    name: "The Vivaah Tales",
    type: "Web experience",
    status: "Live website",
    description: "A dedicated digital presence for The Vivaah Tales.",
    url: "https://the-vivaah-tales.netlify.app/",
    label: "Visit website",
    detail: "Wedding and celebration brand website"
  },
  {
    name: "MK Basketball",
    type: "Sports website",
    status: "Live domain",
    description: "A dedicated web presence for MK Basketball.",
    url: "https://mkballer.strix.website/",
    label: "Visit mkballer.strix.website",
    detail: "Basketball"
  },
  {
    name: "Imrabo",
    type: "Studio product ecosystem",
    status: "Prototype / iterative development",
    description: "An AI product direction explored across a public website, workspace experience and mobile app.",
    links: [
      { label: "Website", url: "https://imrabo.com/" },
      { label: "Workspace", url: "https://imrabo.com/workspace" },
      { label: "Mobile app", url: "https://imrabo.com/" }
    ],
    detail: "AI product exploration"
  }
];
---
<section id="selected-projects" class="border-b border-border py-16 sm:py-20 lg:py-24">
  <div class="strix-container space-y-10">
    <header class="max-w-3xl space-y-4">
      <p class="editorial-meta text-primary">Additional selected work</p>
      <h2 class="editorial-serif type-heading-1">Digital experiences across different industries.</h2>
      <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">A selection of additional websites and product surfaces connected to our engineering work.</p>
    </header>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => <article class="flex h-full flex-col border border-border bg-card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 border-b border-border pb-4"><span class="editorial-meta text-primary">{project.type}</span><span class="font-mono text-[10px] text-muted-foreground">{project.status}</span></div>
        <h3 class="editorial-serif mt-5 text-3xl">{project.name}</h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
        <p class="mt-4 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">{project.detail}</p>
        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-sm font-medium">
          {project.links ? project.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary">{link.label} ↗</a>) : <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary">{project.label} ↗</a>}
        </div>
      </article>)}
    </div>
  </div>
</section>