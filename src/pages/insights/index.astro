---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("insights", ({data}) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Insights | Strix Engineering Studio" description="Architecture guides, system design notes, and product engineering thinking from Strix.">
<section class="section-space"><div class="strix-container space-y-12"><header class="max-w-4xl space-y-5 border-b border-border pb-8"><p class="editorial-meta text-primary">Insights</p><h1 class="editorial-serif type-display-lg">Architecture guides, system design notes, and product engineering thinking</h1><p class="max-w-3xl text-sm leading-relaxed text-muted-foreground sm:text-base">Practical writing that explains the decisions behind durable systems, not generic marketing content.</p></header>
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{posts.map(post=><article class="flex flex-col border border-border bg-card p-6"><div class="flex justify-between border-b border-border pb-3"><span class="editorial-meta text-primary">{post.data.tag}</span><time class="font-mono text-[10px] text-muted-foreground" datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString("en",{month:"short",year:"numeric"})}</time></div><h2 class="editorial-serif mt-5 text-2xl"><a href={`/insights/${post.slug}/`}>{post.data.title}</a></h2><p class="mt-3 flex-1 text-sm text-muted-foreground">{post.data.excerpt}</p><a class="mt-5 border-t border-border pt-4 text-sm" href={`/insights/${post.slug}/`}>Read article ↗</a></article>)}</div>
</div></section>
</BaseLayout>