---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const studies = await getCollection("caseStudies", ({data}) => data.status === "published" && data.visibility !== "private");
  return studies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}
const { study } = Astro.props;
const { Content } = await render(study);
---
<BaseLayout title={`${study.data.title} | Strix Engineering Studio`} description={study.data.description || study.data.subtitle} canonical={`/case-studies/${study.slug}/`} image={study.data.cover || "/strix.svg"}>
<section class="section-space"><div class="strix-container space-y-10">
  <header class="max-w-4xl space-y-5 border-b border-border pb-8">
    <p class="editorial-meta text-primary">{study.data.category} · {study.data.visibility === "anonymized" ? "Anonymized client project" : study.data.client || "Selected work"}</p>
    <h1 class="editorial-serif type-display-lg">{study.data.title}</h1>
    <p class="body-large max-w-3xl text-muted-foreground">{study.data.subtitle}</p>
  </header>
  {study.data.cover && <img src={study.data.cover} alt={study.data.title} class="max-h-[34rem] w-full border border-border bg-surface-warm object-cover"/>}
  <article class="prose"><Content /></article>
  <div class="border-t border-border pt-6"><a href="/case-studies/" class="text-sm text-primary">← Back to selected work</a></div>
</div></section>
</BaseLayout>