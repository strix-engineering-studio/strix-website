---
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorityPages } from "../seo/content";
export async function getStaticPaths() {
  return authorityPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.title,
  description: page.description,
  url: `https://strix.website/${page.slug}/`
};
---
<BaseLayout title={`${page.title} | Strix Engineering Studio`} description={page.description} canonical={`/${page.slug}/`}>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<section class="section-space"><div class="strix-container space-y-10">
  <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted-foreground"><a href="/" class="hover:text-primary">Home</a> <span class="mx-2">/</span><span class="text-foreground">{page.title}</span></nav>
  <header class="max-w-4xl space-y-5 border-b border-border pb-8"><p class="editorial-meta text-primary">Strix engineering principles</p><h1 class="editorial-serif type-display-lg">{page.title}</h1><p class="body-large max-w-3xl text-muted-foreground">{page.description}</p></header>
  <div class="grid gap-8 lg:grid-cols-12">
    <main class="space-y-8 border border-border bg-card p-6 shadow-sm sm:p-8 lg:col-span-8">
      {[
        ["What is this?", page.whatIsThis],
        ["Who is it for?", page.whoIsItFor],
        ["What problem does it solve?", page.whatProblemDoesItSolve],
        ["How does it work?", page.howDoesItWork],
        ["Why this matters", page.whyChooseStrix]
      ].map(([heading, body]) => <section class="border-b border-border/70 pb-6 last:border-0 last:pb-0"><p class="font-mono text-[10px] uppercase tracking-[.22em] text-primary">{heading}</p><p class="mt-2 text-sm leading-relaxed text-muted-foreground sm:text-base">{body}</p></section>)}
    </main>
    <aside class="space-y-6 lg:col-span-4">
      {page.related.length > 0 && <section class="border border-border bg-card p-5"><p class="font-mono text-[10px] uppercase tracking-[.24em] text-primary">Related resources</p><ul class="mt-4 space-y-2">{page.related.map(item => <li><a class="text-sm hover:text-primary" href={item.href.endsWith("/") ? item.href : item.href + "/"}>{item.label} ↗</a></li>)}</ul></section>}
      {page.faqs.length > 0 && <section class="border border-border bg-card p-5"><p class="font-mono text-[10px] uppercase tracking-[.24em] text-primary">Frequently asked questions</p><div class="mt-4 space-y-4">{page.faqs.map(faq => <details class="border-b border-border pb-3 last:border-0"><summary class="cursor-pointer text-sm font-semibold">{faq.question}</summary><p class="mt-2 text-xs leading-relaxed text-muted-foreground">{faq.answer}</p></details>)}</div></section>}
    </aside>
  </div>
  <div class="border border-border bg-surface-warm p-6 sm:p-8"><p class="editorial-meta text-primary">Continue exploring</p><h2 class="editorial-serif mt-2 text-3xl">Connect this principle to a real product challenge.</h2><a href="/contact/" class="mt-5 inline-flex border border-primary bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground">Start a project inquiry ↗</a></div>
</div></section>
</BaseLayout>