---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { servicePages } from "../../seo/content";
const groups = [
  { title: "Validate", summary: "Resolve product and technical uncertainty before committing to a full build.", slugs: ["poc-development", "technical-architecture", "architecture-review", "system-design"] },
  { title: "Launch", summary: "Build the core experience and supporting systems for a new digital product.", slugs: ["mvp-development", "product-engineering", "full-stack-product-delivery", "web-application-development", "mobile-application-development", "nestjs-development", "ai-product-engineering"] },
  { title: "Improve", summary: "Strengthen and extend software that is already in use.", slugs: ["product-modernization", "software-reliability", "backend-systems", "api-development", "software-integration", "workflow-automation"] }
];
const findService = (slug: string) => servicePages.find((item) => item.slug === slug);
---
<BaseLayout title="Product Engineering Services | Strix Engineering Studio" description="Product discovery, POC and MVP development, full-stack engineering, AI systems, and product modernization." canonical="/services/">
<section class="section-space"><div class="strix-container space-y-12">
  <header class="max-w-4xl space-y-5 border-b border-border pb-8">
    <p class="editorial-meta text-primary">Services & engagement</p>
    <h1 class="editorial-serif type-display-lg">Product engineering for the stage you're at.</h1>
    <p class="body-large max-w-3xl text-muted-foreground">From validating an idea to evolving a product in use, Strix brings product thinking and engineering together around what needs to work.</p>
    <a href="/contact/" class="inline-flex min-h-12 items-center gap-3 border border-primary bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground">Discuss a project ↗</a>
  </header>
  <div class="grid gap-4 lg:grid-cols-3">
    {groups.map((group, i) => <section class="border border-border bg-card p-5 sm:p-6">
      <p class="font-mono text-xs tracking-[.18em] text-primary">0{i+1} / {group.title}</p>
      <h2 class="editorial-serif mt-4 text-3xl">{group.title}</h2>
      <p class="mt-3 min-h-16 text-sm leading-relaxed text-muted-foreground">{group.summary}</p>
      <ul class="mt-5 space-y-2 border-t border-border pt-4">{group.slugs.map(slug => { const item = findService(slug); return item ? <li><a class="text-sm hover:text-primary" href={`/services/${item.slug}/`}>{item.title} ↗</a></li> : null; })}</ul>
    </section>)}
  </div>
  <section class="border-t border-border pt-8">
    <div class="mb-6"><p class="editorial-meta text-primary">Service catalogue</p><h2 class="editorial-serif mt-2 text-3xl">Browse engineering capabilities.</h2></div>
    <div class="grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {servicePages.map(item => <a href={`/services/${item.slug}/`} class="bg-background p-4 transition-colors hover:bg-surface-warm"><span class="editorial-serif text-xl">{item.title}</span><span class="mt-2 block text-xs leading-relaxed text-muted-foreground">{item.description}</span><span class="mt-3 block text-xs font-medium text-primary">Explore service ↗</span></a>)}
    </div>
  </section>
</div></section>
</BaseLayout>